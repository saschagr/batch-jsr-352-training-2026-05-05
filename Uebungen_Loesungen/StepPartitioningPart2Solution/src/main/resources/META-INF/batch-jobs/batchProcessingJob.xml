                    <property name="lastItem" value="99"></property>
                </properties>
                <properties partition="2">
                    <property name="firstItem" value="100"></property>
                    <property name="lastItem" value="149"></property>
                </properties>
                <properties partition="3">
                    <property name="firstItem" value="150"></property>
                    <property name="lastItem" value="199"></property>
                </properties>
                <properties partition="4">
                    <property name="firstItem" value="200"></property>
                    <property name="lastItem" value="249"></property>
                </properties>
            </plan -->
            <mapper ref="de.mathema.batch.job.myChunkStep.partition.MyPartitionMapper" />
            <collector ref="de.mathema.batch.job.myChunkStep.partition.MyPartitionCollector"></collector>
            <analyzer ref="de.mathema.batch.job.myChunkStep.partition.MyPartitionAnalyzer"></analyzer>
            <reducer ref="de.mathema.batch.job.myChunkStep.partition.MyPartitionReducer"></reducer>
        </partition>
    </step>
</job>
