<?xml version="1.0" encoding="UTF-8"?>
<job id="batchProcessingJob" 
	xmlns="https://jakarta.ee/xml/ns/jakartaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/jobXML_2_0.xsd"
	version="2.0"
>
    <step id="myChunkStep">
        <chunk checkpoint-policy="item" item-count="5">
            <reader ref="de.mathema.batch.job.myChunkStep.MyItemReader">
            <properties>
                    <property name="firstItem" value="#{partitionPlan['firstItem']}"/>
                    <property name="lastItem" value="#{partitionPlan['lastItem']}"/>
                </properties>     
			</reader>
            <processor ref="de.mathema.batch.job.myChunkStep.MyItemProcessor"/>
            <writer ref="de.mathema.batch.job.myChunkStep.MyItemWriter"/>
        </chunk>
        <partition>
            <!-- plan partitions="5">
                <properties partition="0">
                    <property name="firstItem" value="0"></property>
